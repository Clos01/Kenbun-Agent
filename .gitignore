# Kenbun Gitignore - Calibrated for Secure Monorepos
# Created by Senior CTO & Architect (Approved by System 2 Audit)

# --- Security, Secrets & Private Keys ---
.antigravity_master.key
.kenbun_master.key
*.pem
*.crt
*.cer
*.pfx
*.p12
id_rsa
id_ecdsa
id_ed25519
.env
.env.*
!.env.example
secrets/
.gitsecret/

# NOTE: Lockfiles (package-lock.json, pnpm-lock.yaml)
# MUST be committed to ensure reproducible builds in CI/CD pipelines.

# --- Poetry (Excluded for Kenbun-Agent) ---
poetry.lock
pyproject.toml

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
*.localstorage
brain_health/
scratch/



# --- OS Junk ---
.DS_Store
Thumbs.db
*.lnk
*.sys
*.tmp

# --- IDEs & Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Package Manager & Build Directories ---
node_modules/
jspm_packages/
bower_components/
.npm/
.yarn/
.pnpm/
.pnpm-store/

# --- Next.js, Monorepos & Frontend Builds ---
.next/
dashboard/.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/
.eslintcache

# --- Python Caches & Virtual Environments ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
.mypy_cache/
.ipynb_checkpoints/
pip-log.txt

# --- Temporary Files & Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
mcp_debug.log
dashboard.log
dashboard/*.log
tmp/
temp/

# --- External Dependencies / Third-Party Repos ---
core/external/

docker-compose.override.yml
kenbun_agent.egg-info/
