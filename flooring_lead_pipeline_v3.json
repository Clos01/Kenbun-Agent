{
  "name": "Flooring Lead Inbound Pipeline V3 (Smart Router)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flooring-lead-capture",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook: Lead Input",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "webhookId": "flooring-lead-webhook-uuid-v3"
    },
    {
      "parameters": {
        "language": "javascript",
        "jsCode": "const lead = $input.item.json.body || $input.item.json.query || {};\n\n// QUALITY GATE: Check if name and address exist\nif (!lead.name && !lead.address) {\n  throw new Error('Invalid lead: Missing both name and address.');\n}\n\n// Normalize data\nreturn {\n  Name: lead.name || 'Unknown Lead',\n  Phone: lead.contractor_phone || 'No Phone',\n  Address: lead.address || 'No Address',\n  Type: lead.work_class || 'General',\n  Value: lead.valuation_est ? `$${lead.valuation_est}` : 'Unknown',\n  Notes: lead.description || 'N/A',\n  Score: lead.score ? parseInt(lead.score, 10) : 0\n};"
      },
      "id": "2",
      "name": "Quality Gate (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "mappingColumnMode": "autoMapInputData",
        "options": {}
      },
      "id": "3",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "number",
        "value1": "={{ $json.Score }}",
        "rules": {
          "rules": [
            {
              "operation": "largerEqual",
              "value2": 80,
              "outputKey": "Hot Lead"
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "4",
      "name": "Smart Router (Score)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "your.email@example.com",
        "subject": "={{ '\ud83d\udea8 HOT LEAD: ' + $json.Name }}",
        "message": "={{ 'We just received a HOT flooring lead (Score: ' + $json.Score + '%)\\n\\nName: ' + $json.Name + '\\nPhone: ' + $json.Phone + '\\nAddress: ' + $json.Address + '\\nValue: ' + $json.Value + '\\n\\nNotes: ' + $json.Notes }}",
        "options": {}
      },
      "id": "5",
      "name": "Gmail: VIP Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        850,
        200
      ]
    },
    {
      "parameters": {},
      "id": "6",
      "name": "No Action",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        850,
        400
      ]
    }
  ],
  "connections": {
    "Webhook: Lead Input": {
      "main": [
        [
          {
            "node": "Quality Gate (Code)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quality Gate (Code)": {
      "main": [
        [
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Google Sheets": {
      "main": [
        [
          {
            "node": "Smart Router (Score)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Smart Router (Score)": {
      "main": [
        [
          {
            "node": "Gmail: VIP Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}