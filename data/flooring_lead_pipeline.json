{
  "name": "Flooring Lead Inbound Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flooring-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook: Inbound Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ],
      "webhookId": "flooring-lead-capture"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.item.json.body || $input.item.json.query || {};\nreturn {\n  name: lead.name || 'Unknown Lead',\n  phone: lead.phone || 'No Phone',\n  address: lead.address || 'No Address',\n  type: lead.type || 'General',\n  sqft: lead.sqft || 'Unknown',\n  card_title: `Lead: ${lead.name || 'Unknown'} - ${lead.type || 'General'}`,\n  card_desc: `Phone: ${lead.phone || 'N/A'}\\nAddress: ${lead.address || 'N/A'}\\nSqFt: ${lead.sqft || 'N/A'}`\n};"
      },
      "id": "2",
      "name": "Normalize Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:1337/api/lists/REPLACE_WITH_LIST_ID/cards",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $json.card_title }}"
            },
            {
              "name": "description",
              "value": "={{ $json.card_desc }}"
            },
            {
              "name": "position",
              "value": "=65535"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Create Planka Card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 650, 200 ]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "REPLACE_WITH_TWILIO_NUMBER",
        "to": "={{ $json.phone }}",
        "message": "=Hi {{ $json.name }}, we received your request for a {{ $json.type }} estimate! Our team will contact you shortly to schedule a walkthrough."
      },
      "id": "4",
      "name": "Auto-Reply (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [ 650, 400 ]
    }
  ],
  "connections": {
    "Webhook: Inbound Lead": {
      "main": [
        [
          {
            "node": "Normalize Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Data": {
      "main": [
        [
          {
            "node": "Create Planka Card",
            "type": "main",
            "index": 0
          },
          {
            "node": "Auto-Reply (Twilio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
