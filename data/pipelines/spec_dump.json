  "backend": {
    "entities": [
      {
        "name": "Vehicle",
        "fields": [
          "id: uuid",
          "name: str",
          "status: str",
          "location_lat: float",
          "location_lng: float",
          "battery_level: int",
          "last_heartbeat: timestamp",
          "assigned_agent_id: uuid"
        ]
      },
      {
        "name": "CallSession",
        "fields": [
          "id: uuid",
          "vehicle_id: uuid",
          "agent_id: uuid",
          "start_time: timestamp",
          "end_time: timestamp",
          "status: str",
          "duration_sec: int",
          "outcome: str"
        ]
      },
      {
        "name": "TelemetryEvent",
        "fields": [
          "id: uuid",
          "call_id: uuid",
          "vehicle_id: uuid",
          "event_type: str",
          "payload_json: json",
          "timestamp: timestamp"
        ]
      },
      {
        "name": "TranscriptSegment",
        "fields": [
          "id: uuid",
          "call_id: uuid",
          "speaker: str",
          "text: str",
          "confidence: float",
          "timestamp: timestamp",
          "storage_url: str"
        ]
      },
      {
        "name": "PromptRevision",
        "fields": [
          "id: uuid",
          "call_id: uuid",
          "original_prompt: text",
          "suggested_prompt: text",
          "status: str",
          "reviewer_id: uuid",
          "reviewed_at: timestamp"
        ]
      },
      {
        "name": "WebhookLog",
        "fields": [
          "id: uuid",
          "source: str",
          "event_type: str",
          "payload_json: json",
          "received_at: timestamp",
          "processed: bool"
        ]
      }
    ],
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/fleet",
        "desc": "List all vehicles with live status",
        "reads": [
          "Vehicle"
        ],
        "writes": []
      },
      {
        "method": "GET",
        "path": "/api/fleet/:id",
        "desc": "Vehicle detail with active calls",
        "reads": [
          "Vehicle",
          "CallSession"
        ],
        "writes": []
      },
      {
        "method": "GET",
        "path": "/api/calls",
        "desc": "Live call telemetry feed",
        "reads": [
          "CallSession",
          "TelemetryEvent"
        ],
        "writes": []
      },
      {
        "method": "GET",
        "path": "/api/calls/:id/transcript",
        "desc": "Fetch transcript for a call",
        "reads": [
          "TranscriptSegment"
        ],
        "writes": []
      },
      {
        "method": "POST",
        "path": "/api/webhooks/n8n/ingest",
        "desc": "n8n ingestion webhook for telemetry/call events",
        "reads": [],
        "writes": [
          "TelemetryEvent",
          "CallSession",
          "WebhookLog"
        ],
        "payload": {
          "source": "n8n",
          "event_type": "call.telemetry",
          "vehicle_id": "veh_123",
          "call_id": "call_456",
          "data": {
            "speed": 42,
            "status": "in_transit"
          },
          "timestamp": "2024-06-01T12:00:00Z"
        }
      },
      {
        "method": "POST",
        "path": "/api/transcripts/store",
        "desc": "Store transcript segment into Azure PostgreSQL/Supabase",
        "reads": [],
        "writes": [
          "TranscriptSegment"
        ],
        "payload": {
          "call_id": "call_456",
          "speaker": "agent",
          "text": "Confirming pickup location...",
          "confidence": 0.94,
          "storage_url": "supabase://transcripts-bucket/call_456.json"
        }
      },
      {
        "method": "GET",
        "path": "/api/prompts/queue",
        "desc": "List pending prompt revisions",
        "reads": [
          "PromptRevision"
        ],
        "writes": []
      },
      {
        "method": "PATCH",
        "path": "/api/prompts/:id",
        "desc": "Edit suggested prompt text",
        "reads": [
          "PromptRevision"
        ],
        "writes": [
          "PromptRevision"
        ],
        "payload": {
          "suggested_prompt": "Updated agent response text for edge case handling."
        }
      },
      {
        "method": "POST",
        "path": "/api/prompts/:id/approve",
        "desc": "Approve suggested prompt revision",
        "reads": [
          "PromptRevision"
        ],
        "writes": [
          "PromptRevision"
        ],
        "payload": {
          "reviewer_id": "admin_789",
          "status": "approved"
        }
      },
      {
        "method": "POST",
        "path": "/api/prompts/:id/reject",
        "desc": "Reject suggested prompt revision",
        "reads": [
          "PromptRevision"
        ],
        "writes": [
          "PromptRevision"
        ],
        "payload": {
          "reviewer_id": "admin_789",
          "status": "rejected"
        }
      },
      {
        "method": "POST",
        "path": "/api/integrations/webhook/test",
        "desc": "Trigger test webhook call to n8n",
        "reads": [],
        "writes": [
          "WebhookLog"
        ],
        "payload": {
          "target": "n8n",
          "test": true
        }
      },
      {
        "method": "POST",
        "path": "/api/integrations/db/sync",
        "desc": "Force sync/reconnect to Azure PostgreSQL/Supabase",
        "reads": [],
        "writes": [],
        "payload": {
          "target": "azure_postgres"
        }
      }
    ],
    "flows": [
      {
        "from": "Refresh Fleet",
        "to": "/api/fleet"
      },
      {
        "from": "View Vehicle Detail",
        "to": "/api/fleet/:id"
      },
      {
        "from": "Open Transcript",
        "to": "/api/calls/:id/transcript"
      },
      {
        "from": "Pause Feed",
        "to": "/api/calls"
      },
      {
        "from": "Approve",
        "to": "/api/prompts/:id/approve"
      },
      {
        "from": "Reject",
        "to": "/api/prompts/:id/reject"
      },
      {
        "from": "Save Edit",
        "to": "/api/prompts/:id"
      },
      {
        "from": "Test Webhook",
        "to": "/api/integrations/webhook/test"
      },
      {
        "from": "Sync Database",
        "to": "/api/integrations/db/sync"
      }
    ],
    "integrations": [
      {
        "name": "n8n",
        "kind": "workflow automation / webhook ingestion",
        "via": [
          "/api/webhooks/n8n/ingest",
          "/api/integrations/webhook/test"
        ]
      },
      {
        "name": "Azure PostgreSQL",
        "kind": "primary relational database",
        "via": [
          "/api/transcripts/store",
          "/api/integrations/db/sync"
        ]
      },
      {
        "name": "Supabase",
        "kind": "transcript storage & realtime sync",
        "via": [
          "/api/transcripts/store",
          "/api/calls/:id/transcript"
        ]
      }
    ]
  }
}