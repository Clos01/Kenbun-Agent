#!/usr/bin/env python3
import os
import re
import sys
import glob

def scan_dir(target_dir):
    patterns = [
        os.path.join(target_dir, "src/**/*.tsx"),
        os.path.join(target_dir, "src/**/*.jsx"),
        os.path.join(target_dir, "src/**/*.html"),
    ]
    files = []
    for p in patterns:
        files.extend(glob.glob(p, recursive=True))

    findings = []
    for fpath in files:
        if "node_modules" in fpath or ".next" in fpath:
            continue
        try:
            with open(fpath, "r", encoding="utf-8") as f:
                lines = f.readlines()
        except Exception:
            continue

        for idx, line in enumerate(lines, 1):
            if "absolute inset-0" in line and "items-center" in line and "items-stretch" not in line and "w-full" not in line:
                findings.append((fpath, idx, "INTRINSIC_COLLAPSE_RISK", line.strip()))
            if re.search(r'max-w-\[(?:6\d\d|7\d\d|8\d\d)px\]', line) and "modal" in fpath.lower():
                findings.append((fpath, idx, "OVERSIZED_MODAL_WIDTH", line.strip()))

    print(f"🛡️  Responsive UI Sentinel Audit: {target_dir}")
    print(f"Total potential layout risks found: {len(findings)}\n")
    for fpath, idx, rtype, snippet in findings:
        print(f"[{rtype}] {os.path.basename(fpath)}:{idx}")
        print(f"   Code: {snippet}\n")

if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 else "."
    scan_dir(target)
