# ==============================================================================
#                 🏛️ KENBUN-AGENT DECOUPLED ASSEMBLY CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and customize it for your local machine's environment.

# --- 1. CORE PATHS & STANDALONE DIRECTORIES ---
# Absolute path to your cloned kenbun-agent directory:
PROJECT_ROOT=/absolute/path/to/your/cloned/kenbun-agent
PROJECT_NAME=kenbun-agent
# Path to the brain_health directory (where memory database and logs are stored)
# Default is relative to docker-compose file: ./brain_health
BRAIN_HEALTH_PATH=./brain_health
# Path to the training directory (where GGUF training datasets and models are loaded)
# Default is relative to docker-compose file: ./kenbun_training
KENBUN_TRAINING_PATH=./kenbun_training

# --- 2. VECTOR DATABASE (LOCAL CHROMA STACK) ---
# Set to 'chromadb' inside docker-compose, or 'localhost' if running natively:
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- 3. HARDWARE-AGNOSTIC LLM GATEWAYS & PROVIDERS ---
# You can route to local Ollama, LM Studio, or cloud providers (OpenAI, Anthropic, Gemini).

# Option A: Local Ollama (Recommended Standalone Setup)
PRIMARY_LLM_URL=http://localhost:11434/v1
PRIMARY_LLM_MODEL=gemma4:12b
OLLAMA_PULL_MODELS="gemma4:12b deepseek-r1:8b"

# Option B: Local LM Studio (Alternative Local Rig)
# PRIMARY_LLM_URL=http://localhost:2065/v1
# PRIMARY_LLM_MODEL=qwen2.5-coder-14b-instruct

# Option C: Cloud Anthropic (High Reliability)
# PRIMARY_LLM_URL=https://api.anthropic.com/v1
# PRIMARY_LLM_MODEL=claude-3-5-sonnet-latest

# Option D: Cloud OpenAI
# PRIMARY_LLM_URL=https://api.openai.com/v1
# PRIMARY_LLM_MODEL=gpt-4o

# --- 4. FALLBACK GATEWAY ---
# Backup model URL and name when primary runs out of budget, is rate-limited, or goes offline.
FALLBACK_LLM_URL=https://api.openai.com/v1
FALLBACK_LLM_MODEL=gpt-4o-mini

# --- 5. API SECURITY KEYS (Fill in as needed) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# --- 6. GOVERNANCE & TELEMETRY BUDGETS ---
DAILY_BUDGET=50.00
TELEMETRY_ENABLED=true
NOTIFICATIONS_ENABLED=true

# --- 7. NETWORK & LAN ACCESS ---
# BIND_IP controls which host interface the Docker ports listen on.
#   127.0.0.1 = this machine only (safe default for laptops)
#   0.0.0.0   = all interfaces — required for LAN access on a server.
# Run `./scripts/setup_lan.sh` to configure LAN access automatically.
BIND_IP=127.0.0.1
ASSEMBLY_PC_IP=192.168.86.251
API_PORT=8001
MONITOR_PORT=8002
DASHBOARD_PORT=3000
DOZZLE_PORT=8888

# Pinned Docker bridge subnet for kenbun_net. Prevents Docker from
# auto-picking a range that collides with your LAN/VPN (which knocks the
# server off the network). Change ONLY if this range overlaps your LAN,
# then recreate: docker compose down && docker compose up -d
KENBUN_SUBNET=172.28.77.0/24

# --- 8. LOCAL MODEL PERFORMANCE (Ollama) ---
# Larger context prevents silent prompt truncation (main cause of small
# local models hallucinating). Flash attention + q8_0 KV cache offset the
# VRAM cost. Lower OLLAMA_CONTEXT_LENGTH to 4096 on GPUs with <4GB VRAM.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# --- 9. AUTOMATIC MEMORY RECALL ---
# When on, the agent auto-surfaces relevant project memory each turn (CLI +
# dashboard chat) with no trigger word needed. Set to 0 to revert to the old
# keyword-gated recall — instant rollback, no code change.
KENBUN_AUTO_RECALL=1
# Hard cap (chars) on injected memory, independent of OLLAMA_CONTEXT_LENGTH.
MEMORY_RECALL_MAX_CHARS=4000
# Chroma vector-distance ceiling (0=identical, higher=less similar). Memories
# above this are dropped as irrelevant. Lower it to be stricter.
MEMORY_RECALL_DISTANCE_THRESHOLD=0.75

