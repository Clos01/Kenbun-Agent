# ==============================================================================
#                 🏛️ KENBUN-AGENT DECOUPLED SWARM CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and customize it for your local machine's environment.

# --- 1. CORE PATHS & STANDALONE DIRECTORIES ---
# Absolute path to your cloned kenbun-agent directory:
PROJECT_ROOT=/absolute/path/to/your/cloned/kenbun-agent
PROJECT_NAME=kenbun-agent
# Path to the brain_health directory (where memory database and logs are stored)
# Default is relative to docker-compose file: ./brain_health
BRAIN_HEALTH_PATH=./brain_health
# Path to the training directory (where GGUF training datasets and models are loaded)
# Default is relative to docker-compose file: ./kenbun_training
KENBUN_TRAINING_PATH=./kenbun_training

# --- 2. VECTOR DATABASE (LOCAL CHROMA STACK) ---
# Set to 'chromadb' inside docker-compose, or 'localhost' if running natively:
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- 3. HARDWARE-AGNOSTIC LLM GATEWAYS & PROVIDERS ---
# You can route to local Ollama, LM Studio, or cloud providers (OpenAI, Anthropic, Gemini).

# Option A: Local Ollama (Recommended Standalone Setup)
PRIMARY_LLM_URL=http://localhost:11434/v1
PRIMARY_LLM_MODEL=llama3.2:3b
OLLAMA_PULL_MODELS="llama3.2:3b deepseek-r1:8b"

# Option B: Local LM Studio (Alternative Local Rig)
# PRIMARY_LLM_URL=http://localhost:2065/v1
# PRIMARY_LLM_MODEL=qwen2.5-coder-14b-instruct

# Option C: Cloud Anthropic (High Reliability)
# PRIMARY_LLM_URL=https://api.anthropic.com/v1
# PRIMARY_LLM_MODEL=claude-3-5-sonnet-latest

# Option D: Cloud OpenAI
# PRIMARY_LLM_URL=https://api.openai.com/v1
# PRIMARY_LLM_MODEL=gpt-4o

# --- 4. FALLBACK GATEWAY ---
# Backup model URL and name when primary runs out of budget, is rate-limited, or goes offline.
FALLBACK_LLM_URL=https://api.openai.com/v1
FALLBACK_LLM_MODEL=gpt-4o-mini

# --- 5. API SECURITY KEYS (Fill in as needed) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# --- 6. GOVERNANCE & TELEMETRY BUDGETS ---
DAILY_BUDGET=50.00
TELEMETRY_ENABLED=true
NOTIFICATIONS_ENABLED=true
API_PORT=8001
MONITOR_PORT=8002
DASHBOARD_PORT=3000
DOZZLE_PORT=8888


# ── AI IDE Context ─────────────────────────────────────────────────────────
# Tells orchestrate which AI IDE is calling Kenbun so it can skip redundant
# external AI calls (e.g. Gemini) when the calling IDE IS the intelligence.
# Values: claude | cursor | vscode | windsurf | local (blank = auto-detect)
# Set to "claude" when using Claude Code / Antigravity.
# Set to "local" to always run the full Gemini-included pipeline.
KENBUN_CALLER_IDE=claude

# --- 7. GIT PUSH WATCHER ---
# Comma-separated list of GitHub repositories to watch for new pushes/commits
GIT_WATCH_REPOS=Clos01/Kenbun-Agent
# How often to check for updates in seconds (default: 600)
GIT_WATCH_INTERVAL=600
# Optional GitHub Personal Access Token to increase API rate limits
GITHUB_TOKEN=your_github_token_here

# ──────────────────────────────────────────────
# 🌐 Network / Tailscale
# ──────────────────────────────────────────────
# Public URL of the host machine (used by Planka BASE_URL and the dashboard host resolver).
# Set to your Tailscale IP or hostname — never committed with real values.
PC_IP_ADDRESS=your.host.ip.here

# Tailscale IP of the swarm sidecar container (shared network namespace).
TAILSCALE_IP=your.tailscale.container.ip.here

# Full base URL Planka uses to generate invite links and redirects.
# Example: http://192.168.1.100:1337  or  http://board.yourdomain.com
PLANKA_BASE_URL=http://your.host.ip.here:1337

# ──────────────────────────────────────────────
# 🔒 Planka Auth
# ──────────────────────────────────────────────
PLANKA_SECRET_KEY=your_planka_secret_key_here
PLANKA_DEFAULT_ADMIN_EMAIL=admin@example.com
PLANKA_DEFAULT_ADMIN_PASSWORD=your_admin_password_here
